# =============================================================================
# QUICK START (see README.md for full setup)
# =============================================================================
# 1. Start backend: cd ../online_shop-backend && docker compose up -d
# 2. Register trader: POST /api/v1/auth/register-trader
# 3. Verify OTP: POST /api/v1/auth/login/otp
# 4. Wait for admin approval
# 5. Copy: cp .env.example .env
# 6. Edit: SHOP_NAME, TRADER_ID, TRADER_EMAIL, TRADER_PASSWORD, secrets
# 7. Run: docker compose up --build
# 8. Login CMS: http://localhost:8000 | Shop: http://localhost:8001
# =============================================================================

# =============================================================================
# SHOP TEMPLATE CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# SHOP IDENTITY (REQUIRED - Configure for your shop)
# -----------------------------------------------------------------------------
# Unique shop name displayed in UI
SHOP_NAME=My Awesome Shop

# Your trader ID from the main backend system (Trader.id)
TRADER_ID=1

# Trader credentials — used to seed the CMS database on first boot.
# TRADER_PASSWORD_HASH is the bcrypt hash from tradeops (User.password).
# The backend copies it directly — no plain-text password is ever stored here.
# CMS verifies logins against it using passlib (supports both bcrypt and argon2).
TRADER_EMAIL=trader@example.com
TRADER_PASSWORD_HASH=$2b$12$exampleBcryptHashFromTradeopsBackend

# -----------------------------------------------------------------------------
# BACKEND CONNECTION (REQUIRED)
# -----------------------------------------------------------------------------
# URL to the main backend API
# For Docker (default): use the tradeops container on the shared tradeops_network
# For local development outside Docker: use http://localhost:8080
ADMIN_API_BASE_URL=http://tradeops:8080

# -----------------------------------------------------------------------------
# SECURITY KEYS (REQUIRED - CHANGE IN PRODUCTION!)
# -----------------------------------------------------------------------------
# Generate secure random keys for production:
# python -c "import secrets; print(secrets.token_hex(32))"

# JWT secret for CMS authentication
JWT_SECRET_KEY=change-this-cms-jwt-secret-in-production

# JWT secret for Shop customer authentication
SHOP_JWT_SECRET_KEY=change-this-shop-jwt-secret-in-production

# Session secret for cookie encryption
SESSION_SECRET_KEY=change-this-session-secret-in-production

# -----------------------------------------------------------------------------
# DATABASE (Auto-configured by Docker)
# -----------------------------------------------------------------------------
# Only change if using external database
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/brokercms

# -----------------------------------------------------------------------------
# OPTIONAL SETTINGS
# -----------------------------------------------------------------------------
# JWT token expiration
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# File uploads
# MAX_IMAGE_SIZE_MB=5

# Port overrides (change if defaults conflict with other services)
# CMS_PORT=8000
# SHOP_PORT=8001
# DB_PORT=5432
